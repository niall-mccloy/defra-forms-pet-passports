{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if submissionViewerEnabled %}
        <p class="govuk-body">
          <a class="govuk-link" href="/submissions/dashboard">View submission dashboard (local development only)</a>
        </p>
        <p class="govuk-body">
          <a class="govuk-link" href="/submissions">View form submissions (local development only)</a>
        </p>
      {% endif %}
      <p class="govuk-body">
        This is a demonstration of the <strong>forms-engine-plugin</strong>, a Hapi.js plugin for
        rendering and processing GOV.UK-style forms.
      </p>

      <h2 class="govuk-heading-m">EU pet passports</h2>
      <p class="govuk-body">
        Guidance for pet owners and veterinary practices about EU pet passports.
      </p>
      <ul class="govuk-list">
        <li><a class="govuk-link" href="/pet-passports/start">View guidance</a></li>
        <li><a class="govuk-link" href="https://github.com/defra/forms-engine-plugin-example-ui/blob/main/src/server/forms/pet-passports.yaml">View source YAML</a></li>
      </ul>

      <h2 class="govuk-heading-m">Pet passport forecasting</h2>
      <p class="govuk-body">
        A short survey for veterinary practices to forecast demand for pet passports.
      </p>
      <ul class="govuk-list">
        <li><a class="govuk-link" href="/pet-passports-forecasting/start">Enter a forecast</a></li>
        <li><a class="govuk-link" href="https://github.com/defra/forms-engine-plugin-example-ui/blob/main/src/server/forms/pet-passports-forecasting.yaml">View source YAML</a></li>
      </ul>

      <h2 class="govuk-heading-m">Order pet passports</h2>
      <p class="govuk-body">
        Order EU pet passports for a veterinary practice.
      </p>
      <ul class="govuk-list">
        <li><a class="govuk-link" href="/order-pet-passports/start">Start an order</a></li>
        <li><a class="govuk-link" href="https://github.com/defra/forms-engine-plugin-example-ui/blob/main/src/server/forms/order-pet-passports.yaml">View source YAML</a></li>
      </ul>

      <h2 class="govuk-heading-m">Report a problem with a pet passport</h2>
      <p class="govuk-body">
        Report a damaged, destroyed, lost or incorrectly completed pet passport.
      </p>
      <ul class="govuk-list">
        <li><a class="govuk-link" href="/report-pet-passport-damage/start">Start a report</a></li>
        <li><a class="govuk-link" href="https://github.com/defra/forms-engine-plugin-example-ui/blob/main/src/server/forms/report-pet-passport-damage.yaml">View source YAML</a></li>
      </ul>
    </div>
  </div>
{% endblock %}
